# Steam Free-to-Keep Tracker Environment Configuration
# Copy to .env and populate secrets privately. NEVER commit .env to Git!

# Storefront & Locale (Defaults: India / INR / IST)
TARGET_REGION=IN
STEAM_COUNTRY_CODE=in
STEAM_LANGUAGE=english
DEFAULT_CURRENCY=INR
TIMEZONE=Asia/Kolkata
SCAN_INTERVAL_MINUTES=60

# Storage
DATABASE_PATH=data/steam_tracker.db
PDF_CACHE_DIR=data/reports
BACKUP_DIR=data/backups

# Discovery Sources
ENABLE_CHEAPSHARK=true
ENABLE_GAMERPOWER=true
ENABLE_STEAM_STORE_PAGE_CHECK=true
REQUEST_TIMEOUT_SECONDS=20
MAX_RETRIES=3

# Phone Notifications — ntfy.sh (https://ntfy.sh)
# Choose a hard-to-guess private topic name and subscribe to it in the ntfy Android app.
NTFY_SERVER_URL=https://ntfy.sh
NTFY_TOPIC=
NTFY_TOKEN=

# Phone Notifications — Telegram Bot API
# Create a bot via @BotFather and get your Chat ID via @userinfobot.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Only send VERIFIED alerts by default; set to true to also receive QUARANTINED alerts
NOTIFY_QUARANTINED=false

# Server & Security
HOST=0.0.0.0
PORT=8000
# Random secret required by Cloudflare Cron Worker / GitHub Actions to trigger /api/v1/scans/trigger
TRIGGER_API_KEY=change-this-to-a-long-random-secret
CORS_ORIGINS=*
